# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (direct Postgres connection for SQLAlchemy/Alembic) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# --- Storage ---
SUPABASE_STORAGE_BUCKET=project-documents
SUPABASE_EXPORTS_BUCKET=exports

# --- LLM / Embeddings ---
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-5
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Frontend (frontend/.env.local should mirror these NEXT_PUBLIC_ vars) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
