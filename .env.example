# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (direct Postgres connection for SQLAlchemy/Alembic) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# --- Storage ---
SUPABASE_STORAGE_BUCKET=project-documents
SUPABASE_EXPORTS_BUCKET=exports

# --- LLM / Embeddings ---
# LLM_PROVIDER selects which of the blocks below is used: "claude" or "groq" (groq has a free tier, good for testing).
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

# --- Background jobs ---
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=claude

# --- Frontend (frontend/.env should mirror these VITE_ vars, see frontend/.env.example) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
